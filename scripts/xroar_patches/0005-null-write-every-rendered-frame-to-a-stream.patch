+++ b/src/null/coco_frames.c
@@ -0,0 +1,67 @@
+/** \file
+ *
+ *  \brief coco.py test equipment: every rendered frame from the null UI.
+ *
+ *  Original code for the CoCo starter's instrumented XRoar.
+ *
+ *  When the COCO_FRAMES environment variable names a path, every frame that
+ *  the null UI's software renderer completes is appended to it as a binary
+ *  PPM, the same format as the single COCO_VIDEO frame. The path can be a
+ *  named pipe to an encoder that reads a stream of PPM images. Nothing here
+ *  reads RAM or builds pixels.
+ *
+ *  Log lines on stderr: COCO_FRAMES_START,<tick>,<ticks per second>,<width>,
+ *  <height> before the first frame and COCO_FRAME,<tick> after each frame. If the viewport size
+ *  changes during a recording, COCO_FRAMES_SIZE,<width>,<height> is logged
+ *  and XRoar exits.
+ */
+
+#include "top-config.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "events.h"
+#include "vo_render.h"
+
+#include "null/coco_frames.h"
+
+static FILE *coco_frames_file;
+static int coco_frames_w, coco_frames_h;
+
+static void coco_frames_open(const char *path, int w, int h) {
+	if (!(coco_frames_file = fopen(path, "wb"))) {
+		perror(path);
+		exit(2);
+	}
+	coco_frames_w = w;
+	coco_frames_h = h;
+	fprintf(stderr, "COCO_FRAMES_START,%u,%u,%d,%d\n", (unsigned)event_current_tick,
+	        (unsigned)EVENT_TICK_RATE, w, h);
+}
+
+void coco_frames_write(struct vo_render *vr) {
+	const char *path = getenv("COCO_FRAMES");
+	if (!path)
+		return;
+	int w = vr->viewport.w, h = vr->viewport.h;
+	if (!coco_frames_file)
+		coco_frames_open(path, w, h);
+	if (w != coco_frames_w || h != coco_frames_h) {
+		fprintf(stderr, "COCO_FRAMES_SIZE,%d,%d\n", w, h);
+		exit(2);
+	}
+	fprintf(coco_frames_file, "P6\n%d %d\n255\n", w, h);
+	for (int y = 0; y < h; ++y) {
+		uint32_t *row = (uint32_t *)vr->buffer + y * vr->buffer_pitch;
+		for (int x = 0; x < w; ++x) {
+			uint8_t rgb[3] = { row[x] >> 24, row[x] >> 16, row[x] >> 8 };
+			if (fwrite(rgb, 1, 3, coco_frames_file) != 3)
+				exit(2);
+		}
+	}
+	if (fflush(coco_frames_file))
+		exit(2);
+	fprintf(stderr, "COCO_FRAME,%u\n", (unsigned)event_current_tick);
+}
