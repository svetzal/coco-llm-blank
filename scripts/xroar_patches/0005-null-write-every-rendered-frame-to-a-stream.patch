+ */
+
+#ifndef XROAR_NULL_COCO_FRAMES_H_
+#define XROAR_NULL_COCO_FRAMES_H_
+
+struct vo_render;
+
+// Append the completed frame to the COCO_FRAMES path as a PPM, if it is set.
+void coco_frames_write(struct vo_render *vr);
+
+#endif
