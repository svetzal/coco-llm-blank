+/** \file
+ *
+ *  \brief coco.py test equipment: rendered frames from the null UI.
+ *
+ *  Original code for the CoCo starter's instrumented XRoar.
+ */
+
+#ifndef XROAR_NULL_COCO_VIDEO_H_
+#define XROAR_NULL_COCO_VIDEO_H_
+
+struct vo_interface;
+
+// Give the null UI's video interface XRoar's software renderer and a memory
+// buffer in place of discarding every scanline.
+void coco_video_attach(struct vo_interface *vo);
+
+// Save the second frame completed after this call to the COCO_VIDEO path.
+void coco_video_checkpoint(void);
+
+#endif
