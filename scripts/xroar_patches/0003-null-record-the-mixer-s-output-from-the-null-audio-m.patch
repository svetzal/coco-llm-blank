+/** \file
+ *
+ *  \brief coco.py test equipment: mixer output from the null audio module.
+ *
+ *  Original code for the CoCo starter's instrumented XRoar.
+ */
+
+#ifndef XROAR_NULL_COCO_AUDIO_H_
+#define XROAR_NULL_COCO_AUDIO_H_
+
+#include <stdint.h>
+
+#define COCO_AUDIO_RATE 44100
+#define COCO_AUDIO_FRAMES 1024
+
+// The buffer XRoar's mixer fills: signed 16-bit little-endian mono.
+extern int16_t coco_audio_buffer[COCO_AUDIO_FRAMES];
+
+// Open the COCO_AUDIO path, if set.
+void coco_audio_open(void);
+
+// Append one completed mixer buffer.
+void coco_audio_write(const void *buffer);
+
+// Close the recording.
+void coco_audio_close(void);
+
+#endif
